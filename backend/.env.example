DATABASE_URL=postgresql+psycopg://composer:change-me@127.0.0.1:5432/composer
# Relative paths are resolved against backend/, regardless of process cwd.
ASSET_ROOT=../.data/assets
PROVIDER_MODE=fake
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=104857600
MAX_REFERENCES=10
MAX_AUDIO_SECONDS=600
MEDIA_TIMEOUT_SECONDS=60
FFMPEG=ffmpeg
FFPROBE=ffprobe
WORKER_POLL_SECONDS=1
LEASE_SECONDS=120
